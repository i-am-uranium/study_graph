APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080

DATABASE_URL=postgresql+psycopg://studygraph:studygraph@localhost:5432/studygraph
UPLOAD_DIR=storage/uploads

# --- Chat + embeddings (OSS-local via Ollama, OpenAI-compatible API) ---
# OPENAI_API_KEY is OPTIONAL: only needed when pointing at a remote
# OpenAI-compatible provider. Local Ollama needs no key — leave it empty.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
SEND_EMBEDDING_DIMENSIONS=false

# --- Reranker (Infinity serving BAAI/bge-reranker-v2-m3) ---
RERANK_ENABLED=true
RERANK_BASE_URL=http://localhost:7997
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=8

VITE_API_BASE_URL=http://localhost:8000
UNSTRUCTURED_API_URL=http://localhost:8001/general/v0/general
